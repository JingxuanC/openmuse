# Copy to .env. Sample mode stays on localhost and uses fictional data.
# Every mode requires a server-only CopilotKit Intelligence project key.
WORKSPACE_MODE=sample
AGENT_BACKEND=sample
PORT=8787
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DATA_DIR=.openmuse
TASK_WORKER_ENABLED=true

# Identity. supabase (default) verifies Supabase project JWTs and derives the
# tenant from `sub`; local keeps the client-supplied access key and one owner.
# AUTH_MODE=local
# SUPABASE_URL=  # defaults to the shared OpenMuse project

# The mobile app signs in against the same project with a public anon key.
# Expo only reads apps/mobile/.env, so this value belongs in that file:
# copy apps/mobile/.env.example to apps/mobile/.env. The anon key is public by
# design; never put the service_role key in a client variable.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# General delegated work: select AGENT_BACKEND=model and a provider/model.
# MODEL=openai/your-model-id
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Optional OpenAI-compatible Responses API endpoint:
# OPENAI_BASE_URL=
# For a gateway model ID such as vendor/model, set MODEL=openai/vendor/model.

# Live Google workspace: WORKSPACE_MODE=live, AGENT_BACKEND=model.
# OPENMUSE_ACCESS_KEY=  # random secret, at least 24 characters
# TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as base64
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth callback is PUBLIC_API_URL + /api/google/callback

# Optional separate task worker; all processes share DATA_DIR for PDF files.
# DATABASE_URL=postgresql://...
# Set TASK_WORKER_ENABLED=false on the API when using pnpm dev:worker.

# Browser worker (separate from the task worker):
# BROWSER_WORKER_URL=http://127.0.0.1:8790
# WORKER_TOKEN=  # same random 32+ character secret in API and browser worker
WORKER_DATA_DIR=.openmuse/browser-profiles
WORKER_HOST=127.0.0.1

# An optional external raw AG-UI agent replaces conversational routing only.
# AGENT_BACKEND=agui
# AGENT_URL=https://your-agent.example/run
# AGENT_TOKEN=
# OpenBot's Intelligence runtime is not this raw AG-UI URL. See its adapter docs.

# LangAlpha's AG-UI gateway. Start it with AGUI_ENABLED=1 (it serves nothing
# otherwise) and point AGENT_URL at its run endpoint:
#   AGENT_BACKEND=agui
#   AGENT_URL=http://127.0.0.1:8000/api/v1/agui/run
# See docs/agui-e2e.md for the full two-sided walkthrough.
#
# AGENT_TOKEN is sent as `Authorization: Bearer <token>`. The gateway wants a
# Supabase access token when it runs in its "platform" host mode, and wants no
# token at all in its "oss" host mode.
#
# Setting AGENT_TOKEN pins every run to that token's LangAlpha user: CopilotKit
# gives server-configured headers precedence over the caller's, so the inbound
# `authorization` header stops being forwarded. Leaving it unset forwards the
# caller's own token, which is what keeps a run inside that user's workspace.
# AGENT_TOKEN=
#
# Hybrid: OpenMuse's own agent stays the conversation's brain and vertical
# agents are offered to it as tools. Needs the same MODEL and provider key as
# AGENT_BACKEND=model, plus VERTICAL_AGENTS.
#   AGENT_BACKEND=hybrid
# A JSON array. Each entry becomes a tool named `name` whose `description` is
# what the model routes on, so write it as a domain. `url` is that agent's
# AG-UI run endpoint. Runs go out under the caller's own Authorization header
# and the chat's thread id, so an unauthenticated call is refused rather than
# run as anyone. Optional timeoutMs (default 300000) and maxResultChars
# (default 20000) bound one delegated run.
#   VERTICAL_AGENTS=[{"name":"finance_agent","description":"live market quotes, financial statements, filings and portfolio research","url":"http://127.0.0.1:8000/api/v1/agui/run"}]
# LangAlpha is the first vertical agent; start it as in the AGENT_URL section
# above. Names must be unique, lowercase, and must not collide with a built-in
# tool (search_mail, browse_web, delegate_task, agent_status, create_goal,
# watch_page, remember_fact, present_choices, open_workspace).
# VERTICAL_AGENTS=

# The gateway reads two backend-specific options out of a run's AG-UI
# `forwardedProps`: `agentMode` ("ptc" unless a client says "flash") and
# `workspaceId` (the caller's most recent workspace unless a client names one).

# Chat threads persist in the server's own database (Postgres or the embedded
# PGlite). The CopilotKit Intelligence cloud is an opt-in legacy backend:
# set INTELLIGENCE_BACKEND=copilotkit and a server-only project key from
# `npx copilotkit@latest login` + `npx copilotkit@latest project select`.
# INTELLIGENCE_BACKEND=local
# CPK_INTELLIGENCE_API_KEY=

# Optional private Docker Linux computer (separate from the browser).
# Build first: docker build -t openmuse-computer:local apps/computer
# Docker must be reachable from the API and any separate task worker.
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openmuse-computer:local
# Stable deployment name shared by API and worker; defaults to a hash of PUBLIC_API_URL.
# COMPUTER_DEPLOYMENT_ID=my-openmuse
# Optional scoped Docker engine, e.g. DOCKER_CONTEXT=colima-openmuse

# Optional Jev interaction choices: off (default), sample scripted decisions, or live SDK.
JEV_MODE=off
# live sends the latest user message, agent-written context and candidate choices to TypeSafe;
# see docs/demos/jev-generative-ui.md#what-live-mode-sends-to-typesafe
# TYPESAFE_API_KEY=  # server-only; required for JEV_MODE=live
# JEV_MODEL=jev-1.13.0
