# Copy to apps/mobile/.env. Expo reads public variables from this directory,
# not from the repository root .env.
#
# The OpenMuse server that serves this app.
# Defaults to http://localhost:8787, or http://10.0.2.2:8787 on the Android emulator.
# EXPO_PUBLIC_API_URL=http://localhost:8787

# Supabase Auth, the same project the server verifies tokens against.
# The anon key is public by design; it is not the service_role key.
# EXPO_PUBLIC_SUPABASE_URL=https://veysvzfcyjxxbhvcfhuv.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# local keeps the single-owner access-key sign-in for a development server
# without Supabase. Anything else, or unset, uses Supabase email sign-in.
# EXPO_PUBLIC_AUTH_MODE=local
